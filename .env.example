# =============================================================================
# The Arbitration Briefings — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# =============================================================================

# Required: Firebase UID of the workspace owner.
# Obtain by signing in with your Google account and logging auth.currentUser.uid
# in the browser console, or by checking the Firebase Auth console.
VITE_OWNER_UID=your_firebase_uid

# Optional, dev only. Set to 'true' to use a real Google sign-in in `npm run dev`
# instead of the forced-owner convenience. Needed for owner work that reads/writes
# Firestore in dev (the gate-2 rules require a genuine authenticated session).
VITE_DEV_REAL_AUTH=

# Firebase web SDK configuration (from Firebase Console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# NOTE: The Gemini API key is NOT a client environment variable.
# Set it as a Firebase Functions secret after deploying:
#   firebase functions:secrets:set GEMINI_API_KEY
# Also set the owner UID as a Functions parameter:
#   firebase functions:params:set OWNER_UID=<your-firebase-uid>
